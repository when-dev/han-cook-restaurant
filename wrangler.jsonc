{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// Copies the prerendered pages into static assets (static-assets incremental cache, see
	// open-next.config.ts). Runs before every `wrangler deploy` / `wrangler dev`, so the Worker
	// never falls back to rendering pages per request, whichever deploy command CI uses.
	"build": {
		"command": "npx opennextjs-cloudflare populateCache local"
	},
	"name": "han-cook-restaurant",
	"compatibility_date": "2026-11-03",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "han-cook-restaurant"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}